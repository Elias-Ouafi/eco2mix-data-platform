# ---------------------------------------------------------------------------
# Configuration eco2mix-data-platform (préfixe ECO2MIX_)
# Copier en .env : cp .env.example .env
# Aucune de ces variables n'est un secret : l'API ODRÉ est publique et anonyme.
# ---------------------------------------------------------------------------

# --- Source ---------------------------------------------------------------
ECO2MIX_API_BASE_URL=https://odre.opendatasoft.com/api/explore/v2.1
ECO2MIX_DATASET_ID=eco2mix-national-tr

# --- Fenêtre d'extraction -------------------------------------------------
# Profondeur de la fenêtre glissante, en heures.
# 3 h couvre le délai de publication de RTE et rattrape les valeurs révisées.
ECO2MIX_LOOKBACK_HOURS=3

# --- Réseau ---------------------------------------------------------------
ECO2MIX_HTTP_TIMEOUT_SECONDS=30
ECO2MIX_MAX_RETRIES=4
ECO2MIX_RETRY_WAIT_SECONDS=1

# Bascule /records -> /exports/csv au-delà de ce nombre de lignes estimées.
# L'API v2.1 plafonne la pagination de /records (limit=100, offset <= 9900).
ECO2MIX_RECORDS_ROW_THRESHOLD=900

# --- Stockage local -------------------------------------------------------
# Chemins relatifs à la racine du dépôt, ou absolus.
# Dans les conteneurs Astro, data/ est monté sur /usr/local/airflow/data.
ECO2MIX_RAW_DIR=data/raw
ECO2MIX_DUCKDB_PATH=data/warehouse/eco2mix.duckdb

# --- Qualité --------------------------------------------------------------
# Le contrôle de fraîcheur échoue si la donnée la plus récente dépasse ce retard.
ECO2MIX_FRESHNESS_MAX_LAG_HOURS=2
